# Same public self-hosted Supabase project used by Ultimate Cutter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only access for atomic entitlement reads and export generation.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origins used when validating redirects and return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ULTIMATE_CUTTER_URL=https://ultimatecutter.com
